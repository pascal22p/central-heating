
GET     /                                   controllers.admin.AdminController.index

GET     /nest/authorize        controllers.admin.NestAdminController.authorize()
GET     /nest/oauth/callback   controllers.admin.NestAdminController.oauthCallback(code: String, state: String)
GET     /nest/set/temperature/:temperature controllers.admin.NestAdminController.setTemperature(temperature: Double)

GET     /graphite/nest    controllers.admin.GraphiteController.pushNest

GET   /schedule/*topic   controllers.admin.ScheduleController.edit(topic: String)
POST  /schedule/*topic   controllers.admin.ScheduleController.save(topic: String)

GET   /override   controllers.admin.HeatingOverrideController.show
POST  /override   controllers.admin.HeatingOverrideController.save
