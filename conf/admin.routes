
GET     /                                   controllers.admin.AdminController.index

GET     /nest/authorize        controllers.admin.NestAdminController.authorize()
GET     /nest/oauth/callback   controllers.admin.NestAdminController.oauthCallback(code: String, state: String)
GET     /nest/set/temperature/:temperature controllers.admin.NestAdminController.setTemperature(temperature: Double)

GET     /graphite/nest    controllers.admin.GraphiteController.pushNest

GET   /schedules         controllers.admin.ScheduleController.showSchedules

GET   /schedules/:id/edit   controllers.admin.ScheduleController.editHeatingSchedule(id: Int)
POST  /schedules/:id/edit   controllers.admin.ScheduleController.saveHeatingSchedule(id: Int)

GET   /schedules/new   controllers.admin.ScheduleController.newHeatingSchedule
POST  /schedules/new   controllers.admin.ScheduleController.createHeatingSchedule

