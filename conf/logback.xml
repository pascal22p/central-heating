<?xml version="1.0" encoding="UTF-8" ?>

<!-- https://www.playframework.com/documentation/latest/SettingsLogger -->

<!DOCTYPE configuration>

<configuration>
  <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>
  <import class="ch.qos.logback.core.ConsoleAppender"/>

  <appender name="STDOUT" class="ConsoleAppender">
    <encoder class="PatternLayoutEncoder">
      <charset>UTF-8</charset>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %highlight(%-5level) %cyan(%logger{36}) %magenta(%X{pekkoSource}) %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="play" level="INFO"/>
  <logger name="application" level="DEBUG"/>
  <logger name="org.jdbcdslog.StatementLogger" level="WARN"/>
  <logger name="org.mariadb.jdbc" level="WARN"/>
  <logger name="org.jdbcdslog.ConnectionLogger" level="WARN"/>
  <logger name="com.zaxxer.hikari.pool.HikariPool" level="WARN"/>
  <logger name="org.eclipse.jetty" level="WARN"/>

  <root level="DEBUG">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
